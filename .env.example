# Optional personal OpenAI server credential (not used by App default).
OPENAI_API_KEY=your_api_key_here

# Optional server-default alternative. Users may also enter these in the app.
AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_workers_ai_token_here

# Shared daily App default credits. Create the table using cloudflare/ai-credits.sql.
CLOUDFLARE_D1_DATABASE_ID=your_database_id_here
CLOUDFLARE_D1_API_TOKEN=your_d1_write_token_here
APP_AI_DAILY_CREDITS=100

# Keep local for the full desktop workflow. Hosted preview deployments should
# use disabled until a durable render worker and object storage are connected.
RENDER_BACKEND=local
NEXT_PUBLIC_RENDER_BACKEND=local
